---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout title="Hung D. Nguyen" sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <!-- <div class="text-xl py-1">Hey there 👋</div> -->
    <div class="text-5xl font-bold text-center">Gallery</div>
    <div class="text-2xl py-3 italic text-center">"because science cannot be done alone"</div>

  <div class="text-3xl w-full mb-5 text-center mt-16">Planetary Makerspace 🌍</div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <img src="/gallery/planetary_makerspace/uuraf_2026.webp" alt="Lab group at symposium" class="w-full h-90 object-cover rounded-lg" />
    <p class="text-lg text-center mt-2 opacity-70">MSU University Undergraduate Research and Arts Forum 2026</p>
  </div>
  <div>
    <img src="/gallery/planetary_makerspace/lpsc_gabe_jackson.webp" alt="LPSC 2025 poster session" class="w-full h-90 object-cover rounded-lg" />
    <p class="text-lg text-center mt-2 opacity-70">Lunar and Planetary Science Conference 2025 with Dr. Jackson Barnes and Dr. Gabriel Nathan</p>
  </div>
  <div>
    <img src="/gallery/planetary_makerspace/pic_w_seth.webp" alt="With advisor Seth Jacobson" class="w-full h-90 object-cover rounded-lg" />
    <p class="text-lg text-center mt-2 opacity-70">With my advisor, Prof. Seth Jacobson</p>
  </div>
</div>

<div>
  <div class="text-3xl w-full mb-5 text-center mt-16">Heidelberg, Germany 🔭</div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 auto-rows-[200px]">
    <img src="/gallery/heidelberg/neckar_river.webp" alt="View of the Neckar river" class="w-full h-full object-cover rounded-lg row-span-2" />
    <img src="/gallery/heidelberg/chalkboard.webp" alt="Astrophysics equations on a chalkboard" class="w-full h-full object-cover rounded-lg" />
    <img src="/gallery/heidelberg/alte_brucke.webp" alt="Alte Brücke over the Neckar" class="w-full h-full object-cover rounded-lg" />
    <img src="/gallery/heidelberg/workstation.webp" alt="Working on protoplanetary disk data" class="w-full h-full object-cover rounded-lg row-span-2" />
    <img src="/gallery/heidelberg/konigstuhl.webp" alt="Heidelberg hillside view" class="w-full h-full object-cover rounded-lg" />
    <img src="/gallery/heidelberg/sunset_hike.webp" alt="Sunset over Heidelberg from the hills" class="w-full h-full object-cover rounded-lg" />

  </div>
    <div class="text-lg text-center mt-2 opacity-70">
      In the summer of 2026, I spent 2.5 months at the Max Planck Institute for Astronomy (MPIA) in Heidelberg as part of their summer internship program.
      Situated in southern Germany, thirty minutes from the French border, I quickly fell in love with the city's historic beauty and its world-renowned prestige
      in physics and astronomy. 
    </div>
</div>


<div class="text-3xl w-full mb-8 text-center mt-16">Collaborators & Mentors 🤝</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[180px] grid-flow-dense">

  <!-- Ngoc Photo: Horizontal (Spans 2 columns) -->
  <figure class="relative group overflow-hidden rounded-2xl md:col-span-2 shadow-md">
    <img src="/gallery/collaborators/ngoc_NASA.webp" alt="With Ngoc Truong at a NASA conference" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <figcaption class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <span class="text-white text-sm font-medium leading-snug">
        With Ngoc Truong, planetary scientist at NASA Goddard
      </span>
    </figcaption>
  </figure>

  <!-- Anders Johansen -->
  <figure class="relative group overflow-hidden rounded-2xl shadow-md">
    <img src="/gallery/collaborators/anders_johansen.webp" alt="With Prof. Anders Johansen" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <figcaption class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <span class="text-white text-sm font-medium leading-snug">
        With Prof. Anders Johansen at the University of Copenhagen
      </span>
    </figcaption>
  </figure>

  <!-- Michiel Lambrechts: Tall Vertical Photo (Spans 2 rows) -->
  <figure class="relative group overflow-hidden rounded-2xl row-span-2 shadow-md">
    <img src="/gallery/collaborators/michiel_lambrechts.webp" alt="With Dr. Michiel Lambrechts" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <figcaption class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <span class="text-white text-sm font-medium leading-snug">
        With Prof. Michiel Lambrechts at the University of Copenhagen
      </span>
    </figcaption>
  </figure>

  <!-- Vietnamese Planetary Scientists -->
  <figure class="relative group overflow-hidden rounded-2xl shadow-md">
    <img src="/gallery/collaborators/vnese_planets.webp" alt="With fellow Vietnamese planetary scientists at LPI" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <figcaption class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <span class="text-white text-sm font-medium leading-snug">
        With fellow Vietnamese planetary scientists at LPSC 2025 (Woodlands Texas)
      </span>
    </figcaption>
  </figure>

  <!-- Dieu @ UMich -->
  <figure class="relative group overflow-hidden rounded-2xl shadow-md">
    <img src="/gallery/collaborators/dieu_umich.webp" alt="With a collaborator at University of Michigan" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <figcaption class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <span class="text-white text-xs font-medium leading-tight">
        With Dr. Dieu Nguyen, a postdoc at UMich
      </span>
    </figcaption>
  </figure>

  <!-- Dang Pham & Darryl Seligman -->
  <figure class="relative group overflow-hidden rounded-2xl shadow-md">
    <img src="/gallery/collaborators/dang_pham_cu_boulder.webp" alt="With a collaborator at CU Boulder" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <figcaption class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-90 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <span class="text-white text-xs font-medium leading-tight">
        With Dr. Dang Pham (left), a postdoc at CU Boulder, and Darryl Seligman (right), professor at MSU
      </span>
    </figcaption>
  </figure>

</div>

