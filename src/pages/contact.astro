---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">MY RESEARCH 🪐</div>
  </div>

  <HorizontalCard
    title="Protoplanetary Disk Modelling"
    img="/HD163296.webp"
    desc="Understanding dust around a protoplanetary disk provides crucial insight into planetary
    formation processes. Multi-wavelength observations allow us to constrain the temperature,
    density, and distribution of the dust. Specifically, in the disk HD 163296, a perculiar dichotomy is 
    observed, with an outer ring being visible in the millimeter-wavelength, but invisible in the infrared.
    Here, we construct a self-consistent thick disk structure model from first principles to see if this
    dichotomy can be reproduced."
    url="#"
    badge="NEW"
  />
  <div class="divider my-0"></div>
