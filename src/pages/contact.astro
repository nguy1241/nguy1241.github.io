<BaseLayout title="Contact" sideBarActiveItemID="contact">
  <div class="max-w-4xl mx-auto py-4">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-extrabold tracking-tight mb-2">Contact Me 💬</h1>
      <p class="text-base-content/70 text-lg">
        I'm always down to talk research, academics, about film, or just to say hi!
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Email Card -->
      <a 
        href="mailto:nguy1241@msu.edu" 
        class="group p-5 rounded-2xl bg-base-200 hover:bg-base-300 transition-all duration-300 border border-base-300 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary">Academic & Research</span>
          <span class="text-xl group-hover:scale-110 transition-transform">✉️</span>
        </div>
        <div>
          <div class="text-sm text-base-content/60 font-medium">Direct Email</div>
          <div class="text-lg font-bold group-hover:text-primary transition-colors">nguy1241@msu.edu</div>
        </div>
      </a>

      <!-- LinkedIn Card -->
      <a 
        href="https://www.linkedin.com/in/nguyen-dac-hung/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group p-5 rounded-2xl bg-base-200 hover:bg-base-300 transition-all duration-300 border border-base-300 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-info">Professional</span>
          <span class="text-xl group-hover:scale-110 transition-transform">💼</span>
        </div>
        <div>
          <div class="text-sm text-base-content/60 font-medium">LinkedIn</div>
          <div class="text-lg font-bold group-hover:text-info transition-colors">Hung D. Nguyen ↗</div>
        </div>
      </a>

      <!-- Instagram Card -->
      <a 
        href="https://www.instagram.com/nd_hung.films" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group p-5 rounded-2xl bg-base-200 hover:bg-base-300 transition-all duration-300 border border-base-300 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-secondary">Creative & Film</span>
          <span class="text-xl group-hover:scale-110 transition-transform">📸</span>
        </div>
        <div>
          <div class="text-sm text-base-content/60 font-medium">Instagram</div>
          <div class="text-lg font-bold group-hover:text-secondary transition-colors">@nd_hung.films ↗</div>
        </div>
      </a>

      <!-- TikTok Card -->
      <a 
        href="https://www.tiktok.com/@nd_hung.films" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group p-5 rounded-2xl bg-base-200 hover:bg-base-300 transition-all duration-300 border border-base-300 flex flex-col justify-between"
      >
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">Shortform Video</span>
          <span class="text-xl group-hover:scale-110 transition-transform">🎬</span>
        </div>
        <div>
          <div class="text-sm text-base-content/60 font-medium">TikTok</div>
          <div class="text-lg font-bold group-hover:text-accent transition-colors">@nd_hung.films ↗</div>
        </div>
      </a>

    </div>
  </div>
</BaseLayout>